# --- Go (Golang) ---
# Binarios compilados
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Herramientas de test y cobertura
*.test
*.out
coverage.txt

# Dependencias (Solo si no usas vendoring explícito)
# vendor/

# Espacio de trabajo (Go Workspaces)
go.work
go.work.sum

# --- Terraform ---
# Directorio de trabajo local (proveedores y módulos)
.terraform
.terraform.lock.hcl
.terraform/*

# Archivos de estado (CONTIENEN DATOS SENSIBLES)
*.tfstate
*.tfstate.*

# Variables locales y secretos
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Logs de Terraform
crash.log
*.log

# Archivo de bloqueo de dependencias (OPCIONAL)
# Se recomienda incluirlo en el repositorio para consistencia en el equipo.
# .terraform.lock.hcl

# --- Entorno y Secretos ---
.env
.envrc
*.pem
*.key

# --- IDEs y Editores ---
# VS Code
.vscode/
!.vscode/extensions.json

# JetBrains (GoLand)
.idea/

# macOS
.DS_Store

# --- Específicos del Proyecto (Infra-diagram) ---
# Si corres Neo4j localmente o generas diagramas temporales
data/
logs/
tmp/